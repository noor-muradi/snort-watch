# Copy to .env and set values for the Linux host being monitored.
SNORT_INTERFACE=eth0
SNORT_HOME_NET=192.168.1.0/24
# Keep normalized alert records for this many days.
ALERT_RETENTION_DAYS=30
# Rotate raw Snort log files daily or when a file reaches this size.
SNORT_LOG_RETENTION_DAYS=7
SNORT_LOG_ROTATE_SIZE_MB=100
